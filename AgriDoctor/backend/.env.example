FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES=86400
# In Render, set DATABASE_URL to the database's External Database URL.
DATABASE_URL=postgresql://username:password@localhost:5432/agridoc
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
WEATHER_API_KEY=your_weather_api_key_here
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
MODEL_CONFIDENCE_THRESHOLD=0.35
DISEASE_MODEL_PATH=ml_models/disease_model/disease_model.keras
